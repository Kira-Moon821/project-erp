# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 数据库（由 scripts/seed_db.py 重新生成即可）
data/*.db
data/*.db-shm
data/*.db-wal
data/*.sqlite3

# 环境变量（.env.example 是模板，.env 不入库）
.env
!.env.example

# BI 导出产物：CSV 与 Excel 工作簿**入库**
# 理由：clone 下来就能直接打开 .twb / .pbip / .xlsx，不用先跑脚本；
# 体积约 14MB，可接受。重新生成：python scripts/export_bi_csv.py
excel/pivot_output/

# Excel 临时锁文件（工作簿本身入库）
~$*.xlsx
*.xlsx.manifest.xml

# Office 临时
~$*
*.tmp

# Power BI 本地状态
bi/powerbi/**/.local/
bi/powerbi/*.PBIX
bi/powerbi/**/Report/Layout

# Tableau 本地状态
bi/tableau/.local/
bi/tableau/*.twb.tmp

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
