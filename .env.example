# ============================================================================
# ERP Analytics Lab · 环境变量示例
# 复制为 .env 后按需修改；真实密钥只放 .env（已被 .gitignore 忽略），不要提交
# ============================================================================

# 应用
APP_NAME=ERP Analytics Lab
ENVIRONMENT=local
API_PREFIX=/api
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# 数据库：默认 SQLite（零配置，clone 下来即可跑）
#   sqlite:///./data/erp.db
# 切 MySQL 8（Docker）：
#   1) docker compose up -d
#   2) 把下面一行改成：mysql+pymysql://erp:erp_password@127.0.0.1:3306/erp_db?charset=utf8mb4
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/erp.db
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---------------------------------------------------------------------------
# 认证：生产环境必须换成随机强密钥（启动时会校验，占位值会被拒绝）
#   生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_HASH_ITERATIONS=200000

# CORS 显式来源（禁止通配符 *）
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 限流：每 IP 每分钟请求数
RATE_LIMIT_PER_MINUTE=240

# 种子数据窗口与随机种子（保证任何机器生成的数据完全一致）
SEED_RANDOM_SEED=42
SEED_START_DATE=2024-01-01
SEED_END_DATE=2025-12-31
