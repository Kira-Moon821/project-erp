		toColumn: dim_customer.customer_id

	relationship rel_fact_lead_opportunity_dim_employee_9
		fromColumn: fact_lead_opportunity.owner_employee_id
		toColumn: dim_employee.employee_id

	relationship rel_fact_lead_opportunity_dim_date_10
		fromColumn: fact_lead_opportunity.created_date
		toColumn: dim_date.full_date

	relationship rel_fact_customer_ticket_dim_customer_11
		fromColumn: fact_customer_ticket.customer_id
		toColumn: dim_customer.customer_id

	relationship rel_fact_customer_ticket_dim_date_12
		fromColumn: fact_customer_ticket.created_date
		toColumn: dim_date.full_date

	relationship rel_fact_marketing_spend_dim_date_13
		fromColumn: fact_marketing_spend.date
		toColumn: dim_date.full_date

	relationship rel_fact_ai_usage_dim_employee_14
		fromColumn: fact_ai_usage.employee_id
		toColumn: dim_employee.employee_id

	relationship rel_fact_ai_usage_dim_date_15
		fromColumn: fact_ai_usage.date
		toColumn: dim_date.full_date
