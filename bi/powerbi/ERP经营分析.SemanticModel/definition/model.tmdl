	measure '营收' = CALCULATE(SUM(fact_sales_order[net_amount]), fact_sales_order[order_status] = "已完成", fact_sales_order[is_return] = 0)
		formatString: #,##0.00
		annotation PBI_ResultType = Numeric

	measure '毛利' = CALCULATE(SUM(fact_sales_order[gross_profit]), fact_sales_order[order_status] = "已完成", fact_sales_order[is_return] = 0)
		formatString: #,##0.00
		annotation PBI_ResultType = Numeric

	measure '毛利率' = DIVIDE([毛利], [营收])
		formatString: 0.0%
		annotation PBI_ResultType = Numeric

	measure '完成订单数' = CALCULATE(DISTINCTCOUNT(fact_sales_order[order_id]), fact_sales_order[order_status] = "已完成", fact_sales_order[is_return] = 0)
		formatString: #,##0
		annotation PBI_ResultType = Numeric

	measure '成交客户数' = CALCULATE(DISTINCTCOUNT(fact_sales_order[customer_id]), fact_sales_order[order_status] = "已完成", fact_sales_order[is_return] = 0)
		formatString: #,##0
		annotation PBI_ResultType = Numeric

	measure '客单价' = DIVIDE([营收], [完成订单数])
		formatString: #,##0.00
		annotation PBI_ResultType = Numeric

	measure '平均折扣率' = DIVIDE(CALCULATE(SUM(fact_sales_order[discount_amount]), fact_sales_order[order_status] = "已完成"), CALCULATE(SUM(fact_sales_order[gross_amount]), fact_sales_order[order_status] = "已完成"))
		formatString: 0.0%
		annotation PBI_ResultType = Numeric

	measure '退货订单额' = CALCULATE(SUM(fact_sales_order[net_amount]), fact_sales_order[is_return] = 1)
		formatString: #,##0.00
		annotation PBI_ResultType = Numeric

	measure '营收同比' = VAR Cur = [营收] VAR Prev = CALCULATE([营收], DATEADD(dim_date[full_date], -1, YEAR)) RETURN DIVIDE(Cur - Prev, Prev)
		formatString: 0.0%
		annotation PBI_ResultType = Numeric

	measure '营收环比' = VAR Cur = [营收] VAR Prev = CALCULATE([营收], DATEADD(dim_date[full_date], -1, MONTH)) RETURN DIVIDE(Cur - Prev, Prev)
		formatString: 0.0%
		annotation PBI_ResultType = Numeric

	measure '营收 YTD' = CALCULATE([营收], DATESYTD(dim_date[full_date]))
		formatString: #,##0.00
		annotation PBI_ResultType = Numeric

	measure '库存金额' = SUM(fact_inventory_snapshot[inventory_value])
		formatString: #,##0.00
		annotation PBI_ResultType = Numeric

	measure '缺货 SKU 数' = CALCULATE(DISTINCTCOUNT(fact_inventory_snapshot[product_id]), fact_inventory_snapshot[stock_gap] > 0)
		formatString: #,##0
		annotation PBI_ResultType = Numeric

	measure '缺货率' = DIVIDE([缺货 SKU 数], CALCULATE(DISTINCTCOUNT(fact_inventory_snapshot[product_id])))
		formatString: 0.0%
		annotation PBI_ResultType = Numeric

	measure '在途库存金额' = SUM(fact_inventory_snapshot[in_transit_qty] * fact_inventory_snapshot[unit_cost])
		formatString: #,##0.00
		annotation PBI_ResultType = Numeric

	measure '商机数' = DISTINCTCOUNT(fact_lead_opportunity[lead_id])
		formatString: #,##0
		annotation PBI_ResultType = Numeric

	measure '商机金额' = SUM(fact_lead_opportunity[actual_amount])
		formatString: #,##0.00
		annotation PBI_ResultType = Numeric

	measure '成单数' = CALCULATE(DISTINCTCOUNT(fact_lead_opportunity[lead_id]), fact_lead_opportunity[stage] = "成单")
		formatString: #,##0
		annotation PBI_ResultType = Numeric

	measure '成单率' = DIVIDE([成单数], [商机数])
		formatString: 0.0%
		annotation PBI_ResultType = Numeric

	measure 'AI 辅助成单率' = DIVIDE(CALCULATE(DISTINCTCOUNT(fact_lead_opportunity[lead_id]), fact_lead_opportunity[stage] = "成单", fact_lead_opportunity[ai_assisted] = 1), CALCULATE(DISTINCTCOUNT(fact_lead_opportunity[lead_id]), fact_lead_opportunity[ai_assisted] = 1))
		formatString: 0.0%
		annotation PBI_ResultType = Numeric

	measure '平均销售周期(天)' = AVERAGE(fact_lead_opportunity[cycle_days])
		formatString: #,##0.0
		annotation PBI_ResultType = Numeric

	measure '投放成本' = SUM(fact_marketing_spend[cost_amount])
		formatString: #,##0.00
		annotation PBI_ResultType = Numeric

	measure '归因收入' = SUM(fact_marketing_spend[revenue_attributed])
		formatString: #,##0.00
		annotation PBI_ResultType = Numeric

	measure 'ROAS' = DIVIDE([归因收入], [投放成本])
		formatString: 0.00
		annotation PBI_ResultType = Numeric

	measure 'CAC' = DIVIDE([投放成本], SUM(fact_marketing_spend[leads_count]))
		formatString: #,##0.00
		annotation PBI_ResultType = Numeric

	measure 'AI 调用次数' = SUM(fact_ai_usage[query_count])
		formatString: #,##0
		annotation PBI_ResultType = Numeric

	measure 'AI 采纳率' = DIVIDE(SUM(fact_ai_usage[accepted_count]), SUM(fact_ai_usage[query_count]))
		formatString: 0.0%
		annotation PBI_ResultType = Numeric

	measure 'AI 节省工时' = SUM(fact_ai_usage[minutes_saved])
		formatString: #,##0
		annotation PBI_ResultType = Numeric

	measure 'AI 处理工单占比' = DIVIDE(CALCULATE(DISTINCTCOUNT(fact_customer_ticket[ticket_id]), fact_customer_ticket[ai_handled] = 1), DISTINCTCOUNT(fact_customer_ticket[ticket_id]))
		formatString: 0.0%
		annotation PBI_ResultType = Numeric

	measure '平均工单解决时长' = AVERAGE(fact_customer_ticket[resolution_hours])
		formatString: #,##0.0
		annotation PBI_ResultType = Numeric

	relationship rel_fact_sales_order_dim_customer_1
		fromColumn: fact_sales_order.customer_id
		toColumn: dim_customer.customer_id

	relationship rel_fact_sales_order_dim_employee_2
