// =============================================================================
// ERP 经营分析实验室 — DAX 度量值库
// =============================================================================
//
// 用法
// ----
// 1) Power BI Desktop → 打开数据模型 → 先建一个名为「度量值」的空白表承载全部度量
//    （新建表 → 输入表 → 改名为「度量值」→ 把本文件的度量逐条粘贴进去）
// 2) 每个度量以 `度量名 = ...` 单独粘贴到「度量值」表的新建度量里
// 3) 本文件按主题分 9 组，共 52 个度量值，每条含：公式 / 业务含义 / 使用场景 / 考察点
//
// ★ 字段名与口径来源
// ------------------------------------------------------------------
//   所有列名与表名均与 bi/data/*.csv 的实际结构一致（表名见 model.md §3，
//   列名由 bi/verify_baselines.py 打印校验）。
//   所有指标口径与 docs/数据字典与业务口径.md 一致。
//   每节末尾的「期望基线」来自 `python bi/verify_baselines.py`，
//   建完报表后请逐项对账，数值一致即说明口径实现正确。
//
// ★ 四个贯穿全局的约定
// ------------------------------------------------------------------
//   1) 营收类指标一律只算 `order_status = "已完成"`（字典 §3 + §5）
//   2) 金额一律用 SUM(decimal 列) 后再算比率，绝不 SUM(比率列)
//      （事实表里的 discount_rate / gross_margin / cac / roas / acceptance_rate
//        都是**行级比率**，对它们求和或求平均都是错的）
//   3) 所有比率都用 DIVIDE，不用 `/`（除零保护，DAX 的 `/` 返回错误而非空）
//   4) 分母需要"全体口径"时用 REMOVEFILTERS 显式解除筛选，
//      否则在维度行上分母会被同步过滤，算出恒等于 1 的废数字
//
// ★ 表名前缀
// ------------------------------------------------------------------
//   本文假设表名与 model.md §3 一致：
//     fact_sales_order / fact_sales_order_item / fact_inventory_snapshot
//     fact_lead_opportunity / fact_customer_ticket / fact_marketing_spend
//     fact_ai_usage / dim_date / dim_customer / dim_employee / dim_product
//   若你在 Power Query 里用了 stg_ 前缀，请全文替换表名。
//
// =============================================================================


// =============================================================================
// 组 1  基础聚合（营收 / 毛利 / 订单 / 客户）
// -----------------------------------------------------------------------------
// 口径依据：数据字典 §3「关键指标口径」
// --------------------------------------------------------------------------


// -----------------------------------------------------------------------------
// 1.1 营收（净营收）
// -----------------------------------------------------------------------------
// 业务含义：已完成订单的 net_amount 之和。已退款 / 已取消 / 处理中一律不计。
// 使用场景：经营总览页的主 KPI 卡片；所有营收类度量的计算基数。
// 考察点：CALCULATE + 布尔筛选覆盖上下文中的 order_status 筛选。
//         这里刻意**不**依赖用户在报表上手动筛选订单状态——口径固化在度量里，
//         这样任何时候拖到任何视觉对象上，数字都不会错。
//         副作用（有意为之）：即使报表上筛选了「已退款」，[营收] 仍然只算已完成，
//         因为布尔筛选会**替换**同列上的既有筛选。这正是我们想要的"口径不被交互破坏"。
// 期望基线：70,328,073.02
// -----------------------------------------------------------------------------
营收 =
CALCULATE (
    SUM ( 'fact_sales_order'[net_amount] ),
    'fact_sales_order'[order_status] = "已完成"
)


// -----------------------------------------------------------------------------
// 1.2 吊牌额（折扣前金额）
// -----------------------------------------------------------------------------
// 业务含义：gross_amount 之和，即客户按标价本应支付的总额。
// 使用场景：与营收并列展示，看「让掉了多少」；计算折扣率的分母。
// 期望基线：77,097,918.75
// -----------------------------------------------------------------------------
吊牌额 =
CALCULATE (
    SUM ( 'fact_sales_order'[gross_amount] ),
    'fact_sales_order'[order_status] = "已完成"
)


// -----------------------------------------------------------------------------
// 1.3 折扣额
// -----------------------------------------------------------------------------
// 业务含义：discount_amount 之和。
// 使用场景：折扣力度分析；计算折扣率。
// 期望基线：6,769,845.73
// -----------------------------------------------------------------------------
折扣额 =
CALCULATE (
    SUM ( 'fact_sales_order'[discount_amount] ),
    'fact_sales_order'[order_status] = "已完成"
)


// -----------------------------------------------------------------------------
// 1.4 折扣率
// -----------------------------------------------------------------------------
// 业务含义：折扣额 ÷ 吊牌额。反映整体让利力度。
// 使用场景：经营总览 KPI；按客户分层对比（A 类客户折扣最深）。
// 考察点：DIVIDE 的除零保护。两个分子分母都嵌了「仅已完成」条件，
//         保证在任意筛选上下文下口径一致。
// 期望基线：8.78%（A 类 12.09% > B 类 7.14% > C 类 3.45%）
// -----------------------------------------------------------------------------
折扣率 =
DIVIDE ( [折扣额], [吊牌额] )


// -----------------------------------------------------------------------------
// 1.5 销售成本
// -----------------------------------------------------------------------------
// 业务含义：已完成订单的 cost_amount 之和（成本口径）。
// 使用场景：库存周转天数的分母来源；商品毛利分析。
// 期望基线：59,603,124.58
// -----------------------------------------------------------------------------
销售成本 =
CALCULATE (
    SUM ( 'fact_sales_order'[cost_amount] ),
    'fact_sales_order'[order_status] = "已完成"
)


// -----------------------------------------------------------------------------
// 1.6 毛利
// -----------------------------------------------------------------------------
// 业务含义：gross_profit 之和 = 营收 - 成本。
// 使用场景：经营总览 KPI；与营收配对看盈利能力。
// 期望基线：10,724,948.44
// -----------------------------------------------------------------------------
毛利 =
CALCULATE (
    SUM ( 'fact_sales_order'[gross_profit] ),
    'fact_sales_order'[order_status] = "已完成"
)


// -----------------------------------------------------------------------------
// 1.7 毛利率
// -----------------------------------------------------------------------------
// 业务含义：毛利 ÷ 营收。
// 使用场景：经营总览 KPI；商品结构页看哪些品类赚钱。
// 考察点：分母是**营收**（净额），不是吊牌额。用吊牌额会让毛利率偏低约 0.7pp。
// 期望基线：15.25%
// -----------------------------------------------------------------------------
毛利率 =
DIVIDE ( [毛利], [营收] )


// -----------------------------------------------------------------------------
// 1.8 订单数（仅已完成）
// -----------------------------------------------------------------------------
// 业务含义：已完成订单的行数。字典 §5 明确「已取消」不计入订单数。
// 使用场景：经营总览 KPI；计算客单价的分母。
// 考察点：这里用 COUNTROWS 而非 COUNT(order_id)——两者在本表等价（order_id 唯一），
//         但 COUNTROWS 在有大量重复值时更快，且语义上更贴合"行数即订单数"。
// 期望基线：5,458（全状态 5,727）
// -----------------------------------------------------------------------------
订单数 =
CALCULATE (
    COUNTROWS ( 'fact_sales_order' ),
    'fact_sales_order'[order_status] = "已完成"
)


// -----------------------------------------------------------------------------
// 1.9 客户数
// -----------------------------------------------------------------------------
// 业务含义：不重复下过已完成订单的客户数。
// 使用场景：经营总览 KPI；与订单数相除得客单价。
// 考察点：DISTINCTCOUNT 在大表上开销较高，但在本数据量（5,458 行）下无感知问题。
//         注意：在客户行上下文里，它会返回 1（该客户自己），这是正确行为。
// 期望基线：60
// -----------------------------------------------------------------------------
客户数 =
CALCULATE (
    DISTINCTCOUNT ( 'fact_sales_order'[customer_id] ),
    'fact_sales_order'[order_status] = "已完成"
)


// -----------------------------------------------------------------------------
// 1.10 客单价 AOV
// -----------------------------------------------------------------------------
// 业务含义：营收 ÷ 订单数。
// 使用场景：经营总览 KPI；按分层/区域对比客单价（A 类 14,569 > B/C 类约 11,660）。
// 考察点：引用其他度量而非重写聚合，保证口径唯一来源。
// 期望基线：12,885.32
// -----------------------------------------------------------------------------
客单价 AOV =
DIVIDE ( [营收], [订单数] )


// -----------------------------------------------------------------------------
// 1.11 销售数量（件）
// -----------------------------------------------------------------------------
// 业务含义：已售出的商品件数（明细级 qty 之和）。
// 使用场景：与营收配对，看件均价；辅助识别"低单价高频次"的走量商品。
// 考察点：明细表里 order_status 也有非"已完成"的 743 行，必须同样过滤，
//         否则会与订单表的营收口径打架（对账会不一致）。
// 期望基线：80,339
// -----------------------------------------------------------------------------
销售数量 =
CALCULATE (
    SUM ( 'fact_sales_order_item'[qty] ),
    'fact_sales_order_item'[order_status] = "已完成"
)


// -----------------------------------------------------------------------------
// 1.12 件均价
// -----------------------------------------------------------------------------
// 业务含义：营收 ÷ 销售件数。
// 使用场景：商品结构页辅助判断商品档次。
// 期望基线：875.39
// -----------------------------------------------------------------------------
件均价 =
DIVIDE ( [营收], [销售数量] )


// =============================================================================
// 组 2  时间智能（同比 / 环比 / 累计 / 滚动）
// -----------------------------------------------------------------------------
// 前置条件（三条，缺一不可）：
//   1) dim_date 已「标记为日期表」，标记列为 full_date
//   2) dim_date[full_date] → 各事实表日期列的关系是**单向**的
//   3) dim_date 与事实表之间**没有**其他关系路径
// 期望基线（2025-12 月）：
//   营收同比 +42.30%（4,462,449.39 vs 2024-12 的 3,135,942.13）
//   营收环比 +32.44%（上月 2025-11 为 3,369,342.18）
//   累计 YTD @2025-12 = 37,755,382.34
//   滚动 12 月 @2025-12 = 37,755,382.34；@2025-06 = 35,584,712.84
//   季度：2025Q4 同比 +13.91%
// ⚠ 2024 年各期的同比为 BLANK（无 2023 年数据）——这是正确行为，不是 bug
// --------------------------------------------------------------------------


// -----------------------------------------------------------------------------
// 2.1 去年同期营收
// -----------------------------------------------------------------------------
// 业务含义：当前上下文往前推一年的同期营收。
// 使用场景：作为同比增长率的中间量，也常单独做成"隐藏卡片"配对显示。
// 考察点：SAMEPERIODLASTYEAR 要求日期表已标记，否则函数报错。
//         它作用于日期表列，与事实表的度量配合时靠**关系**传导筛选，
//         这就是"时间上下文"的工作方式。
// -----------------------------------------------------------------------------
去年同期营收 =
CALCULATE ( [营收], SAMEPERIODLASTYEAR ( 'dim_date'[full_date] ) )


// -----------------------------------------------------------------------------
// 2.2 营收同比增长率
// -----------------------------------------------------------------------------
// 业务含义：（本期营收 - 去年同期营收）÷ 去年同期营收。
// 使用场景：经营总览页趋势线旁的同比标注；月度柱状图的目标线。
// 考察点：整个度量只做了一次上下文转换（SAMEPERIODLASTYEAR 产生
//         新的筛选上下文），而 [营收] 内部的 CALCULATE 条件不会丢失，
//         因为「已完成」条件写在度量内部、作用域独立。
// ⚠ 分母为 0 时 DIVIDE 返回 BLANK（不是错误），这正是我们要的行为。
// 期望基线：@2025-12 = +42.30%
// -----------------------------------------------------------------------------
营收同比增长率 =
VAR 当前值 = [营收]
VAR 同期值 = [去年同期营收]
RETURN
    DIVIDE ( 当前值 - 同期值, 同期值 )


// -----------------------------------------------------------------------------
// 2.3 上月营收
// -----------------------------------------------------------------------------
// 业务含义：当前上下文往前推一个月的营收。
// 使用场景：环比计算。
// 考察点：DATEADD 的位移粒度（-1, MONTH）必须与事实表日期列的粒度匹配。
//         本项目事实表存的是**日**级日期，所以用 MONTH 位移；
//         若模型里只有月级日期，则位移粒度要相应调整。
// -----------------------------------------------------------------------------
上月营收 =
CALCULATE ( [营收], DATEADD ( 'dim_date'[full_date], -1, MONTH ) )


// -----------------------------------------------------------------------------
// 2.4 营收环比增长率
// -----------------------------------------------------------------------------
// 业务含义：（本月营收 - 上月营收）÷ 上月营收。
// 使用场景：季节性分析（月度柱状图 + 环比标签）。
// 期望基线：@2025-12 = +32.44%
// 考察点：环比与同比的**分母口径不同**是常见错误来源——
//         环比是"上一期"，同比是"去年同期"。这里的 -1 MONTH 是"上一期"，
//         若把颗粒度换成季度，DATEADD 的参数也要改成 -1, QUARTER。
// -----------------------------------------------------------------------------
营收环比增长率 =
VAR 当前值 = [营收]
VAR 上期值 = [上月营收]
RETURN
    DIVIDE ( 当前值 - 上期值, 上期值 )


// -----------------------------------------------------------------------------
// 2.5 累计 YTD 营收
// -----------------------------------------------------------------------------
// 业务含义：年初到当前上下文日期的累计营收。
// 使用场景：经营总览的"年度进度"卡片；与目标对比。
// 考察点：TOTALYTD 需要日期表标记为日期表，且日期必须连续无缺失。
// ⚠ 注意：dim_date 尾部多出 90 天（2026-01~03），这些日期没有业务数据。
//    若在 2026 年的日期上使用本度量，结果是 BLANK 或残缺值——
//    建议在报表上把日期切片器限制在业务窗口内。
// 期望基线：@2025-12 = 37,755,382.34
// -----------------------------------------------------------------------------
累计 YTD 营收 =
TOTALYTD ( [营收], 'dim_date'[full_date] )


// -----------------------------------------------------------------------------
// 2.6 滚动 12 月营收
// -----------------------------------------------------------------------------
// 业务含义：含当前月在内的最近 12 个月营收合计。
// 使用场景：平滑季节性波动后的趋势线（与原始月度线叠加对比）。
// 考察点：DATESINPERIOD 需要第二个参数为当前上下文的最大日期，
//         用 MAX('dim_date'[full_date]) 取，避免在矩阵中逐格重复计算。
//         -12, MONTH 表示"向前 12 个月的区间"（含端点，共 12 个月）。
// 期望基线：@2025-12 = 37,755,382.34；@2025-06 = 35,584,712.84
// -----------------------------------------------------------------------------
滚动 12 月营收 =
VAR 期末 = MAX ( 'dim_date'[full_date] )
RETURN
    CALCULATE (
        [营收],
        DATESINPERIOD ( 'dim_date'[full_date], 期末, -12, MONTH )
    )


// -----------------------------------------------------------------------------
// 2.7 业务窗口标记（辅助度量）
// -----------------------------------------------------------------------------
// 业务含义：判断当前上下文日期是否落在业务窗口 2024-01-01 ~ 2025-12-31 内。
// 使用场景：配合 dim_date[is_business_window] 列，用于给尾部日期做视觉区分；
//          也可作为其他度量的守门条件。
// 考察点：dim_date 的尾部 90 天是为交付日期预留的，营收分析应排除。
//         推荐做法：在报表层用日期切片器限定 2024-01-01 ~ 2025-12-31，
//         本度量作为二次保险。
// -----------------------------------------------------------------------------
是否业务窗口 =
VAR 当前日 = MAX ( 'dim_date'[full_date] )
RETURN
    IF (
        NOT ISBLANK ( 当前日 )
            && 当前日 >= DATE ( 2024, 1, 1 )
            && 当前日 <= DATE ( 2025, 12, 31 ),
        TRUE (),
        FALSE ()
    )


// =============================================================================
// 组 3  结构分析（商品 ABC 分类 / 帕累托贡献）
// -----------------------------------------------------------------------------
// 口径依据：字典 §3「帕累托贡献 = 商品销售额降序累计占比 ≥ 80% 的商品数量占比」
// 事实表 fact_sales_order_item 是**商品级**的，与订单表通过 order_id 关联。
// ⚠ 三条关键设计（本组的全部难度都在这里）：
//   ① ABC 与帕累托必须在**商品粒度**上做排名，不能直接对订单表排名；
//   ② 排名表必须包含**当前筛选上下文内的全部 SKU**，
//      所以要用 CALCULATETABLE(...REMOVEFILTERS(sku)) 把 SKU 筛选解除，
//      否则在矩阵行上算出来的表只剩当前这一个 SKU，排名恒为 1；
//   ③ 每个 SKU 的销售额必须在**该 SKU 自己的行上下文**里算，
//      靠 ADDCOLUMNS 的隐式上下文转换实现；
//      若不解除 SKU 筛选，外层筛选会与行上下文求交，其他 SKU 全变 0。
// 期望基线（全量上下文）：
//   有销售 SKU 数 = 77
//   帕累托：贡献 80% 营收所需 SKU 数 = 42（占 77 个 SKU 的 54.55%）
//   ABC 分类：A = 41、B = 23、C = 13；A 类累计营收占比 79.64%
//   第 41 名 SKU-0032 累计占比 79.64%；第 42 名 SKU-0066 累计占比 80.56%
// --------------------------------------------------------------------------


// -----------------------------------------------------------------------------
// 3.1 商品销售额（明细级）
// -----------------------------------------------------------------------------
// 业务含义：商品级收入（revenue_amount）。
// 使用场景：ABC 分类与帕累托分析的计算基础。
// 考察点：同样要过滤"仅已完成"，且与订单表口径一致——
//         已验证明细级收入与订单级 net_amount 逐单对账**完全一致**（差异 0 笔）。
// 期望基线：70,328,073.02（与 [营收] 相等）
// -----------------------------------------------------------------------------
商品销售额 =
CALCULATE (
    SUM ( 'fact_sales_order_item'[revenue_amount] ),
    'fact_sales_order_item'[order_status] = "已完成"
)


// -----------------------------------------------------------------------------
// 3.2 商品销售额排名
// -----------------------------------------------------------------------------
// 业务含义：当前上下文内，每个商品按销售额降序的名次（1 = 最高）。
// 使用场景：ABC 分类、帕累托图的排序依据。
// 考察点：三层结构，逐层解决一个坑：
//         ① CALCULATETABLE + REMOVEFILTERS(sku)：拿到上下文内**全部** SKU，
//            否则矩阵行上只剩当前 SKU，排名恒为 1；
//         ② ADDCOLUMNS + [商品销售额]：靠隐式上下文转换，
//            为每个 SKU 算出它自己的销售额；
//         ③ ADDCOLUMNS + RANKX：把名次物化进表，
//            之后就能用 "@排名 <= 当前排名" 精确圈定累计区间。
//         DENSE 排名在本数据集上无并列（已校验 77 个 SKU 销售额互不相同）。
// 用法：把 'fact_sales_order_item'[sku] 放到视觉对象的行轴。
// -----------------------------------------------------------------------------
商品销售额排名 =
VAR 商品表 =
    CALCULATETABLE (
        ADDCOLUMNS (
            SUMMARIZE ( 'fact_sales_order_item', 'fact_sales_order_item'[sku] ),
            "@销售额", [商品销售额]
        ),
        REMOVEFILTERS ( 'fact_sales_order_item'[sku] )
    )
VAR 排名表 =
    ADDCOLUMNS (
        商品表,
        "@排名", RANKX ( 商品表, 商品表[@销售额], , DESC, DENSE )
    )
VAR 当前SKU = SELECTEDVALUE ( 'fact_sales_order_item'[sku] )
RETURN
    MAXX ( FILTER ( 排名表, 排名表[@sku] = 当前SKU ), 排名表[@排名] )


// -----------------------------------------------------------------------------
// 3.3 商品累计销售额占比
// -----------------------------------------------------------------------------
// 业务含义：当前上下文内，按销售额降序排列时，**截至该商品**的累计销售额占比。
// 使用场景：帕累托图的柱形（销售额）与折线（累计占比）配对。
// 考察点：这是本题最经典的 DAX 模式，考点是「物化排名表 + SUMX 累计」：
//         ① 排名表由 3.2 的结构给出（已含 @排名 与 @销售额 两列）；
//         ② 用 FILTER(@排名 <= 当前排名) 圈出"排名不晚于当前商品"的区间；
//         ③ SUMX 累加该区间的销售额，再除以全体销售额 = 累计占比。
//         ★ 关键点：累计占比是**逐行**的值（每个 SKU 行有自己的累计占比），
//           所以它必须放在行轴上；放到 KPI 卡片里会得到一个无意义的数。
// 期望基线：SKU-0032（第 41 名）累计占比 79.64%；SKU-0066（第 42 名）80.56%
// -----------------------------------------------------------------------------
商品累计销售额占比 =
VAR 商品表 =
    CALCULATETABLE (
        ADDCOLUMNS (
            SUMMARIZE ( 'fact_sales_order_item', 'fact_sales_order_item'[sku] ),
            "@销售额", [商品销售额]
        ),
        REMOVEFILTERS ( 'fact_sales_order_item'[sku] )
    )
VAR 排名表 =
    ADDCOLUMNS (
        商品表,
        "@排名", RANKX ( 商品表, 商品表[@销售额], , DESC, DENSE )
    )
VAR 当前SKU = SELECTEDVALUE ( 'fact_sales_order_item'[sku] )
VAR 当前排名 =
    MAXX ( FILTER ( 排名表, 排名表[@sku] = 当前SKU ), 排名表[@排名] )
VAR 累计销售额 =
    SUMX (
        FILTER ( 排名表, 排名表[@排名] <= 当前排名 ),
        排名表[@销售额]
    )
VAR 总销售额 = SUMX ( 排名表, 排名表[@销售额] )
RETURN
    DIVIDE ( 累计销售额, 总销售额 )


// -----------------------------------------------------------------------------
// 3.4 ABC 分类
// -----------------------------------------------------------------------------
// 业务含义：按累计销售额占比把商品分为 A/B/C 三类：
//           A = 累计占比 ≤ 80%；B = ≤ 95%；C = 其余。
// 使用场景：商品与客户结构页的 ABC 矩阵；ABC 分析法（80/15/5 法则）。
// 考察点：这是**行级**分类度量，需要放在以商品为行轴的视觉对象上才有意义。
//         因为累计占比依赖"当前这一行是第几名"，所以不能放到 KPI 卡片的聚合区。
//         SWITCH(TRUE(), ...) 是 DAX 里做多分支判断的惯用写法，
//         比嵌套 IF 更易读，也不会因为漏写 ELSE 而返回空白。
// 期望基线：A = 41 个 SKU、B = 23 个、C = 13 个
// -----------------------------------------------------------------------------
ABC 分类 =
VAR 累计占比 = [商品累计销售额占比]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( 累计占比 ), "无销售",
        累计占比 <= 0.8, "A",
        累计占比 <= 0.95, "B",
        "C"
    )


// -----------------------------------------------------------------------------
// 3.5 帕累托贡献商品数
// -----------------------------------------------------------------------------
// 业务含义：贡献 80% 营收所需的商品个数。
// 使用场景：帕累托图上标注"前 42 个 SKU 撑起 80% 营收"。
// 考察点：统计"累计占比首次达到或超过 80%"的名次——
//         用 MINX + FILTER 在排名表上取第一个满足条件的行号。
//         边界：若某商品的累计占比恰好等于 0.8，MINX 取到它，与验证脚本一致。
// 期望基线：42
// -----------------------------------------------------------------------------
帕累托贡献商品数 =
VAR 商品表 =
    CALCULATETABLE (
        ADDCOLUMNS (
            SUMMARIZE ( 'fact_sales_order_item', 'fact_sales_order_item'[sku] ),
            "@销售额", [商品销售额]
        ),
        REMOVEFILTERS ( 'fact_sales_order_item'[sku] )
    )
VAR 排名表 =
    ADDCOLUMNS (
        商品表,
        "@排名", RANKX ( 商品表, 商品表[@销售额], , DESC, DENSE )
    )
VAR 累计表 =
    ADDCOLUMNS (
        排名表,
        "@累计占比",
            VAR 累计销售额 =
                SUMX (
                    FILTER ( 排名表, 排名表[@排名] <= 排名表[@排名] ),
                    排名表[@销售额]
                )
            RETURN
                DIVIDE ( 累计销售额, SUMX ( 排名表, 排名表[@销售额] ) )
    )
RETURN
    MINX (
        FILTER ( 累计表, 累计表[@累计占比] >= 0.8 ),
        累计表[@排名]
    )


// -----------------------------------------------------------------------------
// 3.6 帕累托贡献度
// -----------------------------------------------------------------------------
// 业务含义：贡献 80% 营收的商品数量 ÷ 有销售的商品总数。
// 使用场景：帕累托图旁的 KPI 卡片，直接回答"多少商品撑起 80% 营收"。
// 口径说明：字典 §3「帕累托贡献 = 商品销售额降序累计占比 ≥ 80% 的商品数量占比」。
// 期望基线：42 / 77 = 54.55%
// -----------------------------------------------------------------------------
帕累托贡献度 =
DIVIDE (
    [帕累托贡献商品数],
    COUNTROWS (
        CALCULATETABLE (
            VALUES ( 'fact_sales_order_item'[sku] ),
            REMOVEFILTERS ( 'fact_sales_order_item'[sku] )
        )
    )
)


// -----------------------------------------------------------------------------
// 3.7 有销售商品数
// -----------------------------------------------------------------------------
// 业务含义：当前上下文内产生过销售的 SKU 数量。
// 使用场景：动销率的分母对照；帕累托贡献度的分母。
// 期望基线：77（dim_product 共 80 个 SKU，其中 3 个从未销售）
// -----------------------------------------------------------------------------
有销售商品数 =
CALCULATE (
    DISTINCTCOUNT ( 'fact_sales_order_item'[sku] ),
    'fact_sales_order_item'[order_status] = "已完成"
)


// -----------------------------------------------------------------------------
// 3.8 在售商品数
// -----------------------------------------------------------------------------
// 业务含义：dim_product 中 status = "在售" 的 SKU 数。
// 使用场景：动销率的分母。
// ⚠ 这是**唯一**能区分"在售/停产"的地方——事实表里没有商品状态字段，
//    所以动销率必须经 dim_product 取数，不能只用事实表。
// 期望基线：77
// -----------------------------------------------------------------------------
在售商品数 =
CALCULATE (
    COUNTROWS ( 'dim_product' ),
    'dim_product'[status] = "在售"
)


// -----------------------------------------------------------------------------
// 3.9 动销率
// -----------------------------------------------------------------------------
// 业务含义：有销售的 SKU 数 ÷ 在售 SKU 数。
// 使用场景：商品健康度 KPI。
// 考察点：分母来自维度表、分子来自事实表，是典型的"跨表比率"，
//         需要确认 dim_product 的 status 筛选能正确作用到事实表。
// 期望基线：100%（本数据集 3 个从未销售的 SKU 恰好都是"停产"状态，
//          且它们在 dim_product 里也不属于"在售"，所以比例恰好是 100%）
// -----------------------------------------------------------------------------
动销率 =
DIVIDE ( [有销售商品数], [在售商品数] )


// =============================================================================
// 组 4  客户分析（RFM 分层 / 近 90 天未成交）
// -----------------------------------------------------------------------------
// 口径依据：字典 §3「RFM：R = 距最近一次成交天数；F = 期间成交次数；
//                      M = 期间成交金额；分档用四分位」
// 分档规则（R/F/M 三项四分位，与 powerquery/erp_model.pq 的 dim_RFM、
//           tableau/calcs.md 完全一致）：
//   R 分（越小越好）：R ≤ P25 → 4；≤ P50 → 3；≤ P75 → 2；否则 1
//   F 分（越大越好）：F ≥ P75 → 4；≥ P50 → 3；≥ P25 → 2；否则 1
//   M 分（越大越好）：M ≥ P75 → 4；≥ P50 → 3；≥ P25 → 2；否则 1
//   组合分层：
//     R≥3 & F≥3 & M≥3 → 重要价值客户
//     R≥3 & F≥3 & M<3  → 重要保持客户
//     R≥3 & F<3  & M≥3 → 重要发展客户
//     R≥3 & F<3  & M<3  → 一般保持客户
//     R<3  & F≥3 & M≥3 → 潜力新客
//     R<3  & F≥3 & M<3  → 潜力成长客户
//     R<3  & F<3  & M≥3 → 流失预警客户
//     R<3  & F<3  & M<3  → 沉睡客户
// 期望基线：
//   R 四分位 1.0 / 4.0 / 8.25 ；F 46.75 / 69.0 / 94.25 ；
//   M 531,828.62 / 793,050.78 / 1,162,534.20
//   分层：重要价值 21 / 沉睡 18 / 一般保持 10 / 潜力新客 7 / 重要保持 2 / 流失预警 2
// --------------------------------------------------------------------------


// -----------------------------------------------------------------------------
// 4.1 客户最近成交日
// -----------------------------------------------------------------------------
// 业务含义：该客户在当前上下文内最近一次已完成订单的日期。
// 使用场景：RFM 的 R 值计算基础；在客户明细表里显示"最后成交日"。
// 考察点：MAX(...) 在客户行的筛选上下文下自动只取该客户的订单，
//         这是 DAX 的"筛选上下文随维度变化"机制。
//         注意 dim_customer → fact_sales_order 的关系是**单向**的
//         （维度→事实），事实表的度量才能被客户维度筛选。
// -----------------------------------------------------------------------------
客户最近成交日 =
CALCULATE (
    MAX ( 'fact_sales_order'[order_date] ),
    'fact_sales_order'[order_status] = "已完成"
)


// -----------------------------------------------------------------------------
// 4.2 客户 R 值（距最近成交天数）
// -----------------------------------------------------------------------------
// 业务含义：参考日 - 最近成交日的天数。参考日取业务窗口末日 2025-12-31。
// 使用场景：RFM 分层。
// 考察点：DATEDIFF 的第三个参数为 DAY。
//         参考日用常量而非 TODAY()——数据集是固定的历史窗口，
//         用 TODAY() 会让结果随系统日期漂移，无法复现与对账。
// 期望基线：R 值区间 0 ~ 38 天
// -----------------------------------------------------------------------------
客户 R 值 =
VAR 最近成交日 = [客户最近成交日]
VAR 参考日 = DATE ( 2025, 12, 31 )
RETURN
    IF ( ISBLANK ( 最近成交日 ), BLANK (), DATEDIFF ( 最近成交日, 参考日, DAY ) )


// -----------------------------------------------------------------------------
// 4.3 客户 F 值（成交次数）
// -----------------------------------------------------------------------------
// 业务含义：当前上下文内该客户的已完成订单笔数。
// 使用场景：RFM 分层。
// 期望基线：区间 28 ~ 251
// -----------------------------------------------------------------------------
客户 F 值 =
CALCULATE (
    COUNTROWS ( 'fact_sales_order' ),
    'fact_sales_order'[order_status] = "已完成"
)


// -----------------------------------------------------------------------------
// 4.4 客户 M 值（成交金额）
// -----------------------------------------------------------------------------
// 业务含义：当前上下文内该客户的已完成订单净营收。
// 使用场景：RFM 分层。
// 期望基线：区间 282,708.70 ~ 3,732,266.22
// -----------------------------------------------------------------------------
客户 M 值 =
CALCULATE (
    SUM ( 'fact_sales_order'[net_amount] ),
    'fact_sales_order'[order_status] = "已完成"
)


// -----------------------------------------------------------------------------
// 4.5 RFM 分层
// -----------------------------------------------------------------------------
// 业务含义：把客户按 R/F/M 三维四分位打分后映射到 8 个业务分层。
// 使用场景：商品与客户结构页的 RFM 分布图；客户运营场景。
// 考察点：这是本题**最重**的度量，考点集中在三处：
//         ① 上下文转换 —— 用 CALCULATETABLE(...REMOVEFILTERS(dim_customer))
//            临时"跳出"当前行的客户筛选，把全体客户拉进来算分位点；
//            否则在客户行上算分位，只会拿该客户自己跟自己比，永远落在中位。
//         ② 迭代器嵌套 —— ADDCOLUMNS 里再套 PERCENTILEX.INC。
//         ③ "全体口径" vs "当前行口径" 的区分 ——
//            四分位点永远来自全体客户（这样各客户之间可比），
//            而 R/F/M 三个原始值来自当前行（这样每个客户有自己的分）。
// ⚠ 性能提示：该度量会遍历全部 60 个客户 × 3 个指标。
//    在大表上建议改用 powerquery/erp_model.pq 的 dim_RFM 预计算表（一次性算好）。
// 用法：把 dim_customer 的客户字段放到行轴。
// 期望基线：重要价值 21 / 沉睡 18 / 一般保持 10 / 潜力新客 7 / 重要保持 2 / 流失预警 2
// -----------------------------------------------------------------------------
RFM 分层 =
VAR 全体客户 =
    CALCULATETABLE (
        ADDCOLUMNS (
            VALUES ( 'dim_customer'[customer_id] ),
            "@R", [客户 R 值],
            "@F", [客户 F 值],
            "@M", [客户 M 值]
        ),
        REMOVEFILTERS ( 'dim_customer' )
    )
VAR R25 = PERCENTILEX.INC ( 全体客户, 全体客户[@R], 0.25 )
VAR R50 = PERCENTILEX.INC ( 全体客户, 全体客户[@R], 0.50 )
VAR R75 = PERCENTILEX.INC ( 全体客户, 全体客户[@R], 0.75 )
VAR F25 = PERCENTILEX.INC ( 全体客户, 全体客户[@F], 0.25 )
VAR F50 = PERCENTILEX.INC ( 全体客户, 全体客户[@F], 0.50 )
VAR F75 = PERCENTILEX.INC ( 全体客户, 全体客户[@F], 0.75 )
VAR M25 = PERCENTILEX.INC ( 全体客户, 全体客户[@M], 0.25 )
VAR M50 = PERCENTILEX.INC ( 全体客户, 全体客户[@M], 0.50 )
VAR M75 = PERCENTILEX.INC ( 全体客户, 全体客户[@M], 0.75 )
VAR 当前R = [客户 R 值]
VAR 当前F = [客户 F 值]
VAR 当前M = [客户 M 值]
VAR R分 =
    SWITCH ( TRUE (), 当前R <= R25, 4, 当前R <= R50, 3, 当前R <= R75, 2, 1 )
VAR F分 =
    SWITCH ( TRUE (), 当前F >= F75, 4, 当前F >= F50, 3, 当前F >= F25, 2, 1 )
VAR M分 =
    SWITCH ( TRUE (), 当前M >= M75, 4, 当前M >= M50, 3, 当前M >= M25, 2, 1 )
RETURN
    SWITCH (
        TRUE (),
        R分 >= 3 && F分 >= 3 && M分 >= 3, "重要价值客户",
        R分 >= 3 && F分 >= 3 && M分 < 3, "重要保持客户",
        R分 >= 3 && F分 < 3 && M分 >= 3, "重要发展客户",
        R分 >= 3 && F分 < 3 && M分 < 3, "一般保持客户",
        R分 < 3 && F分 >= 3 && M分 >= 3, "潜力新客",
        R分 < 3 && F分 >= 3 && M分 < 3, "潜力成长客户",
        R分 < 3 && F分 < 3 && M分 >= 3, "流失预警客户",
        "沉睡客户"
    )


// -----------------------------------------------------------------------------
// 4.6 RFM 客户数
// -----------------------------------------------------------------------------
// 业务含义：当前上下文内参与 RFM 计算的客户数量。
// 使用场景：RFM 分布图的基数校验。
// 期望基线：60
// -----------------------------------------------------------------------------
RFM 客户数 =
COUNTROWS (
    CALCULATETABLE (
        VALUES ( 'dim_customer'[customer_id] ),
        REMOVEFILTERS ( 'dim_customer' )
    )
)


// -----------------------------------------------------------------------------
// 4.7 RFM 分层客户数
// -----------------------------------------------------------------------------
// 业务含义：当前客户所属分层里共有多少客户。
// 使用场景：客户明细表里做成"同层客户数"，或在分层分布图里做成计数。
// 考察点：全体客户表用 REMOVEFILTERS(dim_customer) 解除行上的客户筛选，
//         才能数出"这一层共有多少人"；否则每行都只数到自己（恒为 1）。
//         分层标签用 [RFM 分层] 取当前行所属层，再在全体表里数同层人数。
// 用法：把 dim_customer 的客户字段放到行轴，本度量放在值区。
// 期望基线：重要价值客户 21 / 沉睡客户 18 / 一般保持客户 10 /
//           潜力新客 7 / 重要保持客户 2 / 流失预警客户 2
// -----------------------------------------------------------------------------
RFM 分层客户数 =
VAR 全体客户 =
    CALCULATETABLE (
        ADDCOLUMNS (
            VALUES ( 'dim_customer'[customer_id] ),
            "@分层", [RFM 分层]
        ),
        REMOVEFILTERS ( 'dim_customer' )
    )
RETURN
    COUNTROWS ( FILTER ( 全体客户, 全体客户[@分层] = [RFM 分层] ) )


// -----------------------------------------------------------------------------
// 4.8 近 90 天未成交客户数
// -----------------------------------------------------------------------------
// 业务含义：截至业务窗口末日，近 90 天内没有成交的客户数。
// 使用场景：客户流失预警；库存健康度页的"待激活客户"卡片。
// 考察点：这里用"**当前上下文内**的客户最近成交日"与参考日比较，
//         而不是全局统计——这样在按月份筛选时，能看到"该月视角下"的沉睡客户。
// ⚠ 期望基线为 0：本数据集 60 个客户全部在近 90 天内有成交（最大 R 值仅 38 天）。
//    数值 0 是真实结果，不是公式错误。若想得到非零结果，
//    可把窗口放大到 180 天，或改用 [RFM 分层] = "沉睡客户" 的计数口径。
// -----------------------------------------------------------------------------
近 90 天未成交客户数 =
VAR 参考日 = DATE ( 2025, 12, 31 )
VAR 客户表 =
    CALCULATETABLE (
        ADDCOLUMNS (
            VALUES ( 'dim_customer'[customer_id] ),
            "@最近成交日", [客户最近成交日]
        ),
        REMOVEFILTERS ( 'dim_customer' )
    )
RETURN
    COUNTROWS (
        FILTER (
            客户表,
            ISBLANK ( 客户表[@最近成交日] )
                || 客户表[@最近成交日] < 参考日 - 90
        )
    )


// =============================================================================
// 组 5  库存（金额 / 周转 / 缺货 / 滞销）
// -----------------------------------------------------------------------------
// 口径依据：字典 §3
//   库存周转天数 = 期末库存金额 ÷ 日均销售成本（成本口径，不用售价）
//   缺货率 = on_hand_qty < safety_stock 的 SKU 数 ÷ SKU 总数
//   滞销 SKU = 近 90 天无销售且库存 > 0 的 SKU
// ⚠ 重要：fact_inventory_snapshot 是**月末快照**，每行是"某月末某 SKU 在某仓"的量。
//    因此：
//    · 算"期末库存金额"必须先定位到期末那一个 snapshot_date，不能把 24 个月全加总；
//    · 算"日均销售成本"的分母天数用业务窗口的自然天数（731 天）。
// 期望基线（期末 = 2025-12）：
//   期末库存金额 = 19,067,977.56 ；期末库存数量 = 19,500 件
//   日均销售成本 = 59,603,124.58 / 731 = 81,536.42
//   库存周转天数 = 233.9 天
//   缺货 SKU = 5 / 80 = 6.25%（对应缺货行 8 行）
//   滞销 SKU = 0（3 个从未销售 SKU 的库存恒为 0）
//   在途库存金额 = 4,115,606.83
// --------------------------------------------------------------------------


// -----------------------------------------------------------------------------
// 5.1 期末库存金额
// -----------------------------------------------------------------------------
// 业务含义：最近一期月末快照的库存金额合计（inventory_value）。
// 使用场景：库存健康度页的主 KPI；库存周转天数的分子。
// 考察点：MAX(snapshot_date) 定位期末，再用 CALCULATE 精确筛到这一天。
//         这一步是本题的核心——直接 SUM(inventory_value) 会把 24 个月
//         的快照全部加起来（3.68 亿），完全错误。
// ⚠ 若按月筛选，MAX(snapshot_date) 会落到该月内，所以此度量天然跟随时间筛选，
//    这正是"期末"语义所需要的。
// 期望基线：@全量 = 19,067,977.56（2025-12 快照）
// -----------------------------------------------------------------------------
期末库存金额 =
VAR 期末快照日 =
    CALCULATE ( MAX ( 'fact_inventory_snapshot'[snapshot_date] ) )
RETURN
    CALCULATE (
        SUM ( 'fact_inventory_snapshot'[inventory_value] ),
        'fact_inventory_snapshot'[snapshot_date] = 期末快照日
    )


// -----------------------------------------------------------------------------
// 5.2 期末库存数量
// -----------------------------------------------------------------------------
// 业务含义：期末快照的库存件数合计（on_hand_qty）。
// 使用场景：与库存金额配对，算出平均库存单价（977.85 元/件）。
// 期望基线：@2025-12 = 19,500
// -----------------------------------------------------------------------------
期末库存数量 =
VAR 期末快照日 =
    CALCULATE ( MAX ( 'fact_inventory_snapshot'[snapshot_date] ) )
RETURN
    CALCULATE (
        SUM ( 'fact_inventory_snapshot'[on_hand_qty] ),
        'fact_inventory_snapshot'[snapshot_date] = 期末快照日
    )


// -----------------------------------------------------------------------------
// 5.3 日均销售成本
// -----------------------------------------------------------------------------
// 业务含义：业务窗口内的日均销售成本 = 销售成本 ÷ 天数。
// 使用场景：库存周转天数的分母。
// 考察点：字典明确"用成本口径，不用售价"——所以分母是 [销售成本]，
//         不是 [营收]。若误用营收，周转天数会被低估约 18%
//         （期末库存 ÷ 日均营收 ≈ 172 天，而非 234 天）。
//         天数用 DATEDIFF 计算业务窗口的自然天数（731 天，含首尾），
//         避免"有销售的月份数"这种错误口径。
// ⚠ 分母刻意固定为业务窗口，不随日期筛选变化——
//    这样"周转天数"在不同时间切片下始终可比（同样的分子分母口径）。
//    若要随筛选变化，把天数改成 DATEDIFF(MIN(full_date), MAX(full_date))+1。
// 期望基线：59,603,124.58 / 731 = 81,536.42
// -----------------------------------------------------------------------------
日均销售成本 =
VAR 起始日 = DATE ( 2024, 1, 1 )
VAR 结束日 = DATE ( 2025, 12, 31 )
VAR 天数 = DATEDIFF ( 起始日, 结束日, DAY ) + 1
RETURN
    DIVIDE ( [销售成本], 天数 )


// -----------------------------------------------------------------------------
// 5.4 库存周转天数
// -----------------------------------------------------------------------------
// 业务含义：期末库存金额 ÷ 日均销售成本。
// 使用场景：库存健康度页的核心指标之一（越低越健康）。
// 考察点：分子来自快照表、分母来自订单表，跨表组合；
//         口径必须与字典完全一致：分子=期末库存金额，
//         分母=**成本口径**的日均销售成本。
// 期望基线：233.9 天
// -----------------------------------------------------------------------------
库存周转天数 =
DIVIDE ( [期末库存金额], [日均销售成本] )


// -----------------------------------------------------------------------------
// 5.5 缺货 SKU 数
// -----------------------------------------------------------------------------
// 业务含义：期末快照中 on_hand_qty < safety_stock 的 SKU 数量（去重到 SKU 粒度）。
// 使用场景：库存健康度页的缺货预警卡片；缺货率的分母对照。
// 考察点：DISTINCTCOUNT 到 sku 粒度——因为同一 SKU 在两个仓库各有一行，
//         若用 COUNTROWS 会把"两仓都缺"算成 2 个 SKU（得到 8 而不是 5）。
//         期末定位方式与 5.1 一致。
// 期望基线：5（对应缺货行 8 行，涉及 5 个 SKU）
// -----------------------------------------------------------------------------
缺货 SKU 数 =
VAR 期末快照日 =
    CALCULATE ( MAX ( 'fact_inventory_snapshot'[snapshot_date] ) )
RETURN
    CALCULATE (
        DISTINCTCOUNT ( 'fact_inventory_snapshot'[sku] ),
        'fact_inventory_snapshot'[snapshot_date] = 期末快照日,
        'fact_inventory_snapshot'[on_hand_qty] < 'fact_inventory_snapshot'[safety_stock]
    )


// -----------------------------------------------------------------------------
// 5.6 缺货率
// -----------------------------------------------------------------------------
// 业务含义：缺货 SKU 数 ÷ 期末快照 SKU 总数。
// 使用场景：库存健康度 KPI。
// 期望基线：5 / 80 = 6.25%
// -----------------------------------------------------------------------------
缺货率 =
VAR 期末快照日 =
    CALCULATE ( MAX ( 'fact_inventory_snapshot'[snapshot_date] ) )
VAR SKU总数 =
    CALCULATE (
        DISTINCTCOUNT ( 'fact_inventory_snapshot'[sku] ),
        'fact_inventory_snapshot'[snapshot_date] = 期末快照日
    )
RETURN
    DIVIDE ( [缺货 SKU 数], SKU总数 )


// -----------------------------------------------------------------------------
// 5.7 滞销 SKU 数
// -----------------------------------------------------------------------------
// 业务含义：近 90 天没有销售、但期末库存 > 0 的 SKU 数量。
// 使用场景：库存健康度页的滞销预警；清仓决策。
// 考察点：这是**跨事实表**的度量——需要同时看库存（有没有货）和销售（卖没卖掉）。
//         实现上用"有销售的 SKU 集合"做反向差集：
//         全部期末有库存 SKU − 近 90 天有销售 SKU。
//         集合运算用 EXCEPT（它会对结果去重）。
// ⚠ 期望基线为 0：3 个从未销售的 SKU（SKU-0052 / 0071 / 0078）库存恒为 0，
//    不满足"库存 > 0"，因此滞销数为 0。这是真实结果，不是公式错误。
// -----------------------------------------------------------------------------
滞销 SKU 数 =
VAR 期末快照日 =
    CALCULATE ( MAX ( 'fact_inventory_snapshot'[snapshot_date] ) )
VAR 有库存SKU =
    CALCULATETABLE (
        FILTER (
            VALUES ( 'fact_inventory_snapshot'[sku] ),
            'fact_inventory_snapshot'[on_hand_qty] > 0
        ),
        'fact_inventory_snapshot'[snapshot_date] = 期末快照日
    )
VAR 近90天有销售SKU =
    CALCULATETABLE (
        VALUES ( 'fact_sales_order_item'[sku] ),
        'fact_sales_order_item'[order_status] = "已完成",
        'fact_sales_order_item'[order_date] > 期末快照日 - 90,
        'fact_sales_order_item'[order_date] <= 期末快照日
    )
RETURN
    COUNTROWS ( EXCEPT ( 有库存SKU, 近90天有销售SKU ) )


// -----------------------------------------------------------------------------
// 5.8 在途库存金额
// -----------------------------------------------------------------------------
// 业务含义：期末快照的 in_transit_qty 折算金额（in_transit_qty × unit_cost）。
// 使用场景：采购在途看板；判断补货是否在路上。
// 考察点：in_transit_qty 是**数量**，要乘 unit_cost 才是金额，
//         且不能直接 SUM 整列——必须用 SUMX 逐行相乘。
// 期望基线：4,115,606.83
// -----------------------------------------------------------------------------
在途库存金额 =
VAR 期末快照日 =
    CALCULATE ( MAX ( 'fact_inventory_snapshot'[snapshot_date] ) )
RETURN
    CALCULATE (
        SUMX (
            'fact_inventory_snapshot',
            'fact_inventory_snapshot'[in_transit_qty] * 'fact_inventory_snapshot'[unit_cost]
        ),
        'fact_inventory_snapshot'[snapshot_date] = 期末快照日
    )


// =============================================================================
// 组 6  销售漏斗
// -----------------------------------------------------------------------------
// 口径依据：字典 §3
//   线索转化率 = 某阶段及以后的数量 ÷ 该阶段的数量（漏斗逐级转化）
//   成单率 = stage = '成单' 数量 ÷ 线索总数
// ⚠ 关键：fact_lead_opportunity.stage 记录的是线索**当前所处阶段**，
//    不是历史流转轨迹。所以"到达某阶段及以后"必须这样推导：
//      到达某阶段及以后 = 当前阶段在"该阶段及其之后"的线索数 + 输单数
//    （输单说明线索已走完整个管道，只是最后没成交，所以它到达过所有前置阶段）
//    实测推导：到达线索 1062 / 需求确认 825 / 方案演示 599 / 商务谈判 428 / 成单 295
//    （成单 295 = 成单 184 + 输单 111）
// 期望基线：
//   线索总数 1,062；成单 184；输单 111；成单率 17.33%
//   累计转化率：需求确认 77.68% / 方案演示 56.40% / 商务谈判 40.30% / 成单 27.78%
//   逐级转化率：需求确认 77.68% / 方案演示 72.61% / 商务谈判 71.45% / 成单 68.93%
//   平均销售周期 42.76 天；平均期望金额 476,060.94
// --------------------------------------------------------------------------


// -----------------------------------------------------------------------------
// 6.1 线索数
// -----------------------------------------------------------------------------
// 业务含义：漏斗入口的线索总数。
// 使用场景：漏斗图顶部；成单率的分母。
// 期望基线：1,062
// -----------------------------------------------------------------------------
线索数 =
COUNTROWS ( 'fact_lead_opportunity' )


// -----------------------------------------------------------------------------
// 6.2 成单数
// -----------------------------------------------------------------------------
// 业务含义：stage = "成单" 的线索数。
// 使用场景：漏斗图底部；成单率的分子。
// 期望基线：184
// -----------------------------------------------------------------------------
成单数 =
CALCULATE (
    COUNTROWS ( 'fact_lead_opportunity' ),
    'fact_lead_opportunity'[stage] = "成单"
)


// -----------------------------------------------------------------------------
// 6.3 成单率
// -----------------------------------------------------------------------------
// 业务含义：成单数 ÷ 线索总数。字典 §3 的明确定义。
// 使用场景：漏斗图旁的转化 KPI；销售团队效率评估。
// 期望基线：184 / 1062 = 17.33%
// -----------------------------------------------------------------------------
成单率 =
DIVIDE ( [成单数], [线索数] )


// -----------------------------------------------------------------------------
// 6.4 输单数
// -----------------------------------------------------------------------------
// 业务含义：stage = "输单" 的线索数。
// 使用场景：漏斗图的流失分支；输单原因分析（loss_reason）。
// 期望基线：111
// -----------------------------------------------------------------------------
输单数 =
CALCULATE (
    COUNTROWS ( 'fact_lead_opportunity' ),
    'fact_lead_opportunity'[stage] = "输单"
)


// -----------------------------------------------------------------------------
// 6.5 阶段到达数
// -----------------------------------------------------------------------------
// 业务含义：到达指定阶段及以后的线索数。
// 使用场景：漏斗图各层的柱高。
// 考察点：这是本题最需要小心的度量。stage 是文本，需要用 SWITCH 映射成序号，
//         再用"序号 >= 目标序号"来筛选，最后把"输单"并进来。
//         若直接把 stage 当维度筛选，会得到"停留在该阶段"的数量
//         （如商务谈判 133），而不是"到达过该阶段"的数量（428），
//         两者相差近 3 倍，是最常见的漏斗口径错误。
//         ★ 关键：布尔筛选写在 CALCULATE 的筛选参数位，
//           会**替换**同列上的既有筛选（这里是 stage 自身的筛选），
//           所以不需要额外写 ALL(stage)。
// 用法：把 'fact_lead_opportunity'[stage] 放进视觉对象的行轴，本度量自动按行取值。
// 期望基线：线索 1062 / 需求确认 825 / 方案演示 599 / 商务谈判 428 / 成单 295
// -----------------------------------------------------------------------------
阶段到达数 =
VAR 当前阶段 = SELECTEDVALUE ( 'fact_lead_opportunity'[stage] )
VAR 目标序号 =
    SWITCH (
        当前阶段,
        "线索", 1,
        "需求确认", 2,
        "方案演示", 3,
        "商务谈判", 4,
        "成单", 5,
        5
    )
RETURN
    CALCULATE (
        COUNTROWS ( 'fact_lead_opportunity' ),
        SWITCH (
            TRUE (),
            'fact_lead_opportunity'[stage] = "线索", 1,
            'fact_lead_opportunity'[stage] = "需求确认", 2,
            'fact_lead_opportunity'[stage] = "方案演示", 3,
            'fact_lead_opportunity'[stage] = "商务谈判", 4,
            'fact_lead_opportunity'[stage] = "成单", 5,
            'fact_lead_opportunity'[stage] = "输单", 5,
            0
        ) >= 目标序号
    )


// -----------------------------------------------------------------------------
// 6.6 阶段转化率（逐级）
// -----------------------------------------------------------------------------
// 业务含义：到达本阶段及以后的线索数 ÷ 到达上一阶段及以后的线索数。
// 使用场景：漏斗图每层之间的转化率标签。
// 考察点：分子分母都是"到达"口径（不是"停留"口径），
//         这样每层的转化率才是真正的"这一关留下了多少"。
//         上一阶段的到达数用 CALCULATE 改写 stage 筛选后再调用本度量，
//         由于 [阶段到达数] 内部的布尔筛选会替换 stage 筛选，
//         两处口径完全一致。
// 期望基线：需求确认 77.68% / 方案演示 72.61% / 商务谈判 71.45% / 成单 68.93%
// -----------------------------------------------------------------------------
阶段转化率 =
VAR 当前阶段 = SELECTEDVALUE ( 'fact_lead_opportunity'[stage] )
VAR 当前到达 = [阶段到达数]
VAR 上阶段到达 =
    SWITCH (
        当前阶段,
        "线索", [线索数],
        "需求确认", CALCULATE ( [阶段到达数], 'fact_lead_opportunity'[stage] = "线索" ),
        "方案演示", CALCULATE ( [阶段到达数], 'fact_lead_opportunity'[stage] = "需求确认" ),
        "商务谈判", CALCULATE ( [阶段到达数], 'fact_lead_opportunity'[stage] = "方案演示" ),
        "成单", CALCULATE ( [阶段到达数], 'fact_lead_opportunity'[stage] = "商务谈判" ),
        BLANK ()
    )
RETURN
    DIVIDE ( 当前到达, 上阶段到达 )


// -----------------------------------------------------------------------------
// 6.7 累计转化率
// -----------------------------------------------------------------------------
// 业务含义：到达本阶段及以后的线索数 ÷ 线索总数。
// 使用场景：漏斗图的"整体推进度"标注。
// 期望基线：需求确认 77.68% / 方案演示 56.40% / 商务谈判 40.30% / 成单 27.78%
// -----------------------------------------------------------------------------
累计转化率 =
DIVIDE ( [阶段到达数], [线索数] )


// -----------------------------------------------------------------------------
// 6.8 平均销售周期（天）
// -----------------------------------------------------------------------------
// 业务含义：线索的 cycle_days 平均值（从创建到结束的周期）。
// 使用场景：销售效率分析；AI 对比中的关键结论之一。
// 期望基线：42.76 天
// 考察点：AVERAGE 忽略 BLANK。若某条线索没有 cycle_days，它不参与平均——
//         这比用 SUM/COUNT 手工算更稳（手工算分母错）。
// -----------------------------------------------------------------------------
平均销售周期天数 =
AVERAGE ( 'fact_lead_opportunity'[cycle_days] )


// -----------------------------------------------------------------------------
// 6.9 平均期望金额
// -----------------------------------------------------------------------------
// 业务含义：线索 expected_amount 的平均值，用于衡量漏斗质量（金额体量）。
// 使用场景：漏斗图每层配金额标签。
// 期望基线：476,060.94
// -----------------------------------------------------------------------------
平均期望金额 =
AVERAGE ( 'fact_lead_opportunity'[expected_amount] )


// -----------------------------------------------------------------------------
// 6.10 平均交付周期（天）
// -----------------------------------------------------------------------------
// 业务含义：已完成订单的 delivery_days 平均值（下单到交付）。
// 使用场景：运营效率分析；与销售周期形成对照（销售周期 42.76 天 vs 交付 11.82 天，
//          说明大部分时间消耗在成交前的推进而非履约环节）。
// 期望基线：11.82 天
// -----------------------------------------------------------------------------
平均交付周期天数 =
CALCULATE (
    AVERAGE ( 'fact_sales_order'[delivery_days] ),
    'fact_sales_order'[order_status] = "已完成"
)


// =============================================================================
// 组 7  AI 价值（这是本项目的"销售论证"核心）
// -----------------------------------------------------------------------------
// 口径依据：字典 §3
//   AI 辅助商机赢率 = ai_assisted=1 的平均 win_probability；对照组 ai_assisted=0
//   AI 提效（工单） = AI 处理 vs 人工处理的 first_response_minutes / satisfaction / converted_to_opportunity
//   AI 采纳率 = accepted_count / query_count
//   AI 节省工时 = minutes_saved 求和（小时 = ÷60）
// 期望基线：
//   商机：AI 组 354 条、成单率 21.75%、平均赢率 0.5155、周期 36.53 天
//         对照组 708 条、成单率 15.11%、平均赢率 0.3859、周期 45.87 天
//         成单率提升 +6.64pp（相对提升 +43.94%）
//   工单：AI 组 243 条、首响 18.14 分、满意度 4.5309、转商机率 16.05%
//         人工组 522 条、首响 45.59 分、满意度 3.8755、转商机率 10.54%
//         首响缩短 60.21%；满意度 +0.66 分
//   助手：整体采纳率 70.38%（行级区间 33.33% ~ 90.91%）、累计节省 1,173.65 小时
// --------------------------------------------------------------------------


// -----------------------------------------------------------------------------
// 7.1 AI 辅助商机成单率
// -----------------------------------------------------------------------------
// 业务含义：ai_assisted = 1 的线索中，最终成单的比例。
// 使用场景：AI 价值页的核心对比指标；销售论证的"标题数字"。
// 考察点：CALCULATE + 布尔筛选覆盖 ai_assisted 的筛选上下文。
//         分子分母必须**同时**被这个筛选覆盖——如果只筛了分子，
//         分母仍是全量线索，数字会错得离谱。
//         本写法用「先算两个基础度量，再用 DIVIDE 组合」的方式，
//         两个度量在同一个被覆盖的上下文里求值，口径天然一致。
// 期望基线：21.75%（对照组 15.11%，高出 6.64 个百分点）
// -----------------------------------------------------------------------------
AI 辅助商机成单率 =
DIVIDE (
    CALCULATE ( [成单数], 'fact_lead_opportunity'[ai_assisted] = 1 ),
    CALCULATE ( [线索数], 'fact_lead_opportunity'[ai_assisted] = 1 )
)


// -----------------------------------------------------------------------------
// 7.2 对照组商机成单率
// -----------------------------------------------------------------------------
// 业务含义：ai_assisted = 0 的线索成单率，作为 AI 组的对照基准。
// 使用场景：与 AI 组做并排条形图；计算"提升幅度"。
// 期望基线：15.11%
// 考察点：对照组是**事实上的对照组**，不是随机对照实验。
//         严谨表述应为"AI 辅助组线索成单率高出对照组 X 个百分点"，
//         而不能说"AI 提升了 X% 成交"——因为无法排除线索本身质量的差异。
// -----------------------------------------------------------------------------
对照组商机成单率 =
DIVIDE (
    CALCULATE ( [成单数], 'fact_lead_opportunity'[ai_assisted] = 0 ),
    CALCULATE ( [线索数], 'fact_lead_opportunity'[ai_assisted] = 0 )
)


// -----------------------------------------------------------------------------
// 7.3 AI 商机成单率提升
// -----------------------------------------------------------------------------
// 业务含义：AI 组成单率 − 对照组成单率（单位：百分点）。
// 使用场景：AI 价值页的主结论数字。
// 期望基线：21.75% - 15.11% = 6.64 个百分点（相对提升 43.94%）
// 考察点：用"百分点差值"而非"相对增长率"。
//         若写成 DIVIDE(AI-对照, 对照) = 43.94%，那是相对提升，
//         容易在汇报中被误读成"成单率提升了 43.94%"。
//         两个数都放在卡片上时，务必标注单位是「pp」还是「%」。
// -----------------------------------------------------------------------------
AI 商机成单率提升 =
[AI 辅助商机成单率] - [对照组商机成单率]


// -----------------------------------------------------------------------------
// 7.4 AI 辅助商机平均赢率
// -----------------------------------------------------------------------------
// 业务含义：ai_assisted = 1 的线索 win_probability 平均值。
// 使用场景：AI 价值页的赢率对比条形图。
// 期望基线：0.5155（对照组 0.3859）
// 考察点：字典 §3 定义的"AI 辅助商机赢率"就是"平均 win_probability"，
//         与 7.1 的"成单率"是**两个不同指标**：
//         前者是模型给出的赢概率（0~1 的连续值），
//         后者是实际成交的占比。两者都可用，但不可混用。
// -----------------------------------------------------------------------------
AI 辅助商机平均赢率 =
CALCULATE (
    AVERAGE ( 'fact_lead_opportunity'[win_probability] ),
    'fact_lead_opportunity'[ai_assisted] = 1
)


// -----------------------------------------------------------------------------
// 7.5 对照组商机平均赢率
// -----------------------------------------------------------------------------
// 业务含义：ai_assisted = 0 的线索 win_probability 平均值。
// 期望基线：0.3859
// -----------------------------------------------------------------------------
对照组商机平均赢率 =
CALCULATE (
    AVERAGE ( 'fact_lead_opportunity'[win_probability] ),
    'fact_lead_opportunity'[ai_assisted] = 0
)


// -----------------------------------------------------------------------------
// 7.6 AI 商机平均销售周期
// -----------------------------------------------------------------------------
// 业务含义：ai_assisted = 1 的线索平均 cycle_days。
// 使用场景：AI 价值页；"AI 让销售周期缩短"的论据。
// 期望基线：36.53 天（对照组 45.87 天，缩短 9.34 天）
// -----------------------------------------------------------------------------
AI 商机平均销售周期 =
CALCULATE (
    AVERAGE ( 'fact_lead_opportunity'[cycle_days] ),
    'fact_lead_opportunity'[ai_assisted] = 1
)


// -----------------------------------------------------------------------------
// 7.7 对照组商机平均销售周期
// -----------------------------------------------------------------------------
// 业务含义：ai_assisted = 0 的线索平均 cycle_days。
// 期望基线：45.87 天
// -----------------------------------------------------------------------------
对照组商机平均销售周期 =
CALCULATE (
    AVERAGE ( 'fact_lead_opportunity'[cycle_days] ),
    'fact_lead_opportunity'[ai_assisted] = 0
)


// -----------------------------------------------------------------------------
// 7.8 AI 工单平均首响（分钟）
// -----------------------------------------------------------------------------
// 业务含义：ai_handled = 1 的工单首次响应时长平均值。
// 使用场景：AI 价值页的效率对比条形图。
// 期望基线：18.14 分钟（人工 45.59 分钟，缩短 60.21%）
// -----------------------------------------------------------------------------
AI 工单平均首响分钟 =
CALCULATE (
    AVERAGE ( 'fact_customer_ticket'[first_response_minutes] ),
    'fact_customer_ticket'[ai_handled] = 1
)


// -----------------------------------------------------------------------------
// 7.9 人工工单平均首响（分钟）
// -----------------------------------------------------------------------------
// 业务含义：ai_handled = 0 的工单首次响应时长平均值。
// 期望基线：45.59 分钟
// -----------------------------------------------------------------------------
人工工单平均首响分钟 =
CALCULATE (
    AVERAGE ( 'fact_customer_ticket'[first_response_minutes] ),
    'fact_customer_ticket'[ai_handled] = 0
)


// -----------------------------------------------------------------------------
// 7.10 AI 工单满意度
// -----------------------------------------------------------------------------
// 业务含义：ai_handled = 1 的工单满意度均值（1~5 分）。
// 使用场景：AI 价值页；说明 AI 不只是快，还更让客户满意。
// 期望基线：4.5309（人工 3.8755，高出 0.66 分）
// -----------------------------------------------------------------------------
AI 工单满意度 =
CALCULATE (
    AVERAGE ( 'fact_customer_ticket'[satisfaction] ),
    'fact_customer_ticket'[ai_handled] = 1
)


// -----------------------------------------------------------------------------
// 7.11 人工工单满意度
// -----------------------------------------------------------------------------
// 业务含义：ai_handled = 0 的工单满意度均值。
// 期望基线：3.8755
// -----------------------------------------------------------------------------
人工工单满意度 =
CALCULATE (
    AVERAGE ( 'fact_customer_ticket'[satisfaction] ),
    'fact_customer_ticket'[ai_handled] = 0
)


// -----------------------------------------------------------------------------
// 7.12 AI 工单转商机率
// -----------------------------------------------------------------------------
// 业务含义：ai_handled = 1 的工单中 converted_to_opportunity = 1 的比例。
// 使用场景：AI 价值页；论证 AI 不只是降本，还带来增量线索。
// 考察点：converted_to_opportunity 是 0/1 整数标记，
//         求和再除以总数是正确做法；写成 AVERAGE 也对（0/1 的平均值就是比例），
//         但用 DIVIDE(SUM, COUNT) 语义更明确、跨表复用更稳。
// 期望基线：16.05%（人工 10.54%）
// -----------------------------------------------------------------------------
AI 工单转商机率 =
DIVIDE (
    CALCULATE (
        SUM ( 'fact_customer_ticket'[converted_to_opportunity] ),
        'fact_customer_ticket'[ai_handled] = 1
    ),
    CALCULATE (
        COUNTROWS ( 'fact_customer_ticket' ),
        'fact_customer_ticket'[ai_handled] = 1
    )
)


// -----------------------------------------------------------------------------
// 7.13 人工工单转商机率
// -----------------------------------------------------------------------------
// 业务含义：ai_handled = 0 的工单转商机比例。
// 期望基线：10.54%
// -----------------------------------------------------------------------------
人工工单转商机率 =
DIVIDE (
    CALCULATE (
        SUM ( 'fact_customer_ticket'[converted_to_opportunity] ),
        'fact_customer_ticket'[ai_handled] = 0
    ),
    CALCULATE (
        COUNTROWS ( 'fact_customer_ticket' ),
        'fact_customer_ticket'[ai_handled] = 0
    )
)


// -----------------------------------------------------------------------------
// 7.14 AI 采纳率
// -----------------------------------------------------------------------------
// 业务含义：内部 AI 助手的采纳率 = Σaccepted_count ÷ Σquery_count。
// 使用场景：AI 价值页的"内部提效"板块。
// 考察点：⚠ 关键陷阱——绝对不能写 AVERAGE(acceptance_rate)！
//         acceptance_rate 是**行级比率**，直接平均等于给"只问 3 次"和
//         "问了 18 次"的记录同等权重，结果会失真。
//         必须先各自求和再相除（比率的"正确加权平均"）。
// 期望基线：70.38%
//         字典 §4 写"采纳率约 58%~92%"，那是种子生成时每条记录的
//         概率区间（rng.uniform(0.58, 0.92) 取整后的行级比值），
//         本度量按字典 §3 的口径算出整体采纳率 70.38%。
// -----------------------------------------------------------------------------
AI 采纳率 =
DIVIDE (
    SUM ( 'fact_ai_usage'[accepted_count] ),
    SUM ( 'fact_ai_usage'[query_count] )
)


// -----------------------------------------------------------------------------
// 7.15 AI 累计节省工时（小时）
// -----------------------------------------------------------------------------
// 业务含义：AI 助手累计节省的工时（minutes_saved 求和 ÷ 60）。
// 使用场景：AI 价值页的"内部提效"板块；年度节约成本换算。
// 期望基线：1,173.65 小时（70,419 分钟）
// 考察点：单位换算放在度量里（÷60），保持度量语义单一、便于复用。
// -----------------------------------------------------------------------------
AI 累计节省工时 =
DIVIDE ( SUM ( 'fact_ai_usage'[minutes_saved] ), 60 )


// -----------------------------------------------------------------------------
// 7.16 AI 首响缩短比例
// -----------------------------------------------------------------------------
// 业务含义：（人工首响 − AI 首响）÷ 人工首响。AI 带来的工单响应提速幅度。
// 使用场景：AI 价值页主 KPI；把"分钟数差"翻译成"百分比改善"，更易沟通。
// 期望基线：60.21%
// 考察点：分子分母都用「人工」作基准，避免出现"相对 AI 提升多少"这种
//         容易引起歧义的表达。
// -----------------------------------------------------------------------------
AI 首响缩短比例 =
DIVIDE (
    [人工工单平均首响分钟] - [AI 工单平均首响分钟],
    [人工工单平均首响分钟]
)


// =============================================================================
// 组 8  营销运营（成本 / CAC / ROAS）
// -----------------------------------------------------------------------------
// 口径依据：字典 §3「CAC = 渠道成本 ÷ 线索数；ROAS = 归因收入 ÷ 成本」
// 期望基线：
//   营销成本 6,067,909.95；线索数 10,894；CAC 557.00；ROAS 4.1260
//   归因收入 25,036,276.90
// ⚠ fact_marketing_spend 里已有 cac / roas 两列，但它们是**行级比率**
//    （每条投放记录各算各的）。做汇总时必须重新计算，不能对这两列求和或简单平均。
//    行级 CAC 均值为 634.55，与整体 CAC 557.00 的差异是正常的
//    （各渠道线索量不同，简单平均给了小渠道同等权重）。
// --------------------------------------------------------------------------


// -----------------------------------------------------------------------------
// 8.1 营销成本
// -----------------------------------------------------------------------------
// 业务含义：营销投放总花费。
// 使用场景：运营页；CAC 的分子。
// 期望基线：6,067,909.95
// -----------------------------------------------------------------------------
营销成本 =
SUM ( 'fact_marketing_spend'[cost_amount] )


// -----------------------------------------------------------------------------
// 8.2 营销线索数
// -----------------------------------------------------------------------------
// 业务含义：营销带来的线索数（leads_count 之和）。
// 使用场景：CAC 的分母；与漏斗页的线索数做交叉验证。
// 期望基线：10,894
// ⚠ 营销表的 leads_count（10,894）与漏斗表的线索数（1,062）**不是同一个口径**：
//    前者是渠道上报的原始线索条数，后者是进入系统的去重线索。
//    两者不可互相替代，也不可相减得出"转化率"。
// -----------------------------------------------------------------------------
营销线索数 =
SUM ( 'fact_marketing_spend'[leads_count] )


// -----------------------------------------------------------------------------
// 8.3 归因收入
// -----------------------------------------------------------------------------
// 业务含义：营销归因收入（revenue_attributed 之和）。
// 使用场景：ROAS 的分子。
// 期望基线：25,036,276.90
// -----------------------------------------------------------------------------
归因收入 =
SUM ( 'fact_marketing_spend'[revenue_attributed] )


// -----------------------------------------------------------------------------
// 8.4 CAC（获客成本）
// -----------------------------------------------------------------------------
// 业务含义：渠道成本 ÷ 线索数。
// 使用场景：运营页；按投放渠道对比获客效率。
// 期望基线：6,067,909.95 / 10,894 = 557.00
// 考察点：整体 CAC 必须用"总成本 ÷ 总线索"，
//         不能是各渠道 CAC 的平均值——加权口径与简单平均结果不同。
// -----------------------------------------------------------------------------
CAC =
DIVIDE ( [营销成本], [营销线索数] )


// -----------------------------------------------------------------------------
// 8.5 ROAS（营销回报率）
// -----------------------------------------------------------------------------
// 业务含义：归因收入 ÷ 成本。
// 使用场景：运营页；投放渠道效果排序。
// 期望基线：4.1260（即每投入 1 元带来约 4.13 元归因收入）
// -----------------------------------------------------------------------------
ROAS =
DIVIDE ( [归因收入], [营销成本] )


// -----------------------------------------------------------------------------
// 8.6 行级 CAC 均值（仅供交叉校验）
// -----------------------------------------------------------------------------
// 业务含义：cac 列的平均值，**仅**用于与 8.4 的整体 CAC 做交叉校验。
// 使用场景：数据质量核对页。
// ⚠ 报表主口径请用 [CAC]。本度量是行级比率的平均，
//    与整体 CAC 存在差异（各渠道线索量不同），差异是正常的。
// 期望基线：634.55
// -----------------------------------------------------------------------------
行级 CAC 均值 =
AVERAGE ( 'fact_marketing_spend'[cac] )


// =============================================================================
// 组 9  辅助度量
// --------------------------------------------------------------------------


// -----------------------------------------------------------------------------
// 9.1 各状态订单数
// -----------------------------------------------------------------------------
// 业务含义：按订单状态统计订单数。
// 使用场景：经营总览页底部的订单状态分布条形图（已完成/已退款/处理中/已取消）。
// 考察点：这一组度量**不加**"仅已完成"过滤——它的目的正是展示各状态构成。
//         与 [订单数]（只算已完成）配合使用：一张图看结构，一张卡片看主口径。
// 期望基线：已完成 5,458 / 处理中 98 / 已取消 96 / 已退款 75
// -----------------------------------------------------------------------------
各状态订单数 =
COUNTROWS ( 'fact_sales_order' )


// -----------------------------------------------------------------------------
// 9.2 各状态营收
// -----------------------------------------------------------------------------
// 业务含义：按订单状态统计 net_amount。
// 使用场景：说明"为什么营收要排除已退款"。
// 期望基线：已完成 70,328,073.02；已退款 1,145,504.96；已取消 1,153,461.12；处理中 1,222,429.59
// -----------------------------------------------------------------------------
各状态营收 =
SUM ( 'fact_sales_order'[net_amount] )


// -----------------------------------------------------------------------------
// 9.3 退款率
// -----------------------------------------------------------------------------
// 业务含义：已退款订单数 ÷ 全部订单数。
// 使用场景：经营质量监控；与字典 §1 的订单状态分布（已退款 1.5%）对账。
// 期望基线：75 / 5727 = 1.31%
// -----------------------------------------------------------------------------
退款率 =
DIVIDE (
    CALCULATE ( COUNTROWS ( 'fact_sales_order' ), 'fact_sales_order'[order_status] = "已退款" ),
    COUNTROWS ( 'fact_sales_order' )
)


// -----------------------------------------------------------------------------
// 9.4 分层营收占比
// -----------------------------------------------------------------------------
// 业务含义：各客户分层（A/B/C）的营收贡献占比。
// 使用场景：商品与客户结构页；验证字典 §4「A 类客户贡献营收占比最大」。
// 考察点：★ 分母必须用 REMOVEFILTERS(dim_customer) 解除分层筛选，
//         否则分子分母同被筛成该层，算出来恒等于 100%。
//         这正是"分母要全体口径"的典型案例。
// 期望基线：A 类 33,436,485.34（47.54%）、B 类 20,746,021.89（29.50%）、C 类 16,145,565.79（22.96%）
// 用法：把 dim_customer[tier] 放到行轴。
// -----------------------------------------------------------------------------
分层营收占比 =
VAR 当前分层 = SELECTEDVALUE ( 'dim_customer'[tier] )
VAR 分子 =
    CALCULATE (
        SUM ( 'fact_sales_order'[net_amount] ),
        'fact_sales_order'[order_status] = "已完成"
    )
VAR 分母 =
    CALCULATE (
        SUM ( 'fact_sales_order'[net_amount] ),
        'fact_sales_order'[order_status] = "已完成",
        REMOVEFILTERS ( 'dim_customer' )
    )
RETURN
    DIVIDE ( 分子, 分母 )


// -----------------------------------------------------------------------------
// 9.5 区域营收占比
// -----------------------------------------------------------------------------
// 业务含义：各区域的营收贡献占比。
// 使用场景：商品与客户结构页；地图/条形图。
// 期望基线：华东 32.02% / 华北 22.35% / 华南 12.79% / 西南 32.84%
// 考察点：同上，分母用 REMOVEFILTERS(dim_customer) 取全体口径。
// 用法：把 dim_customer[region] 放到行轴。
// -----------------------------------------------------------------------------
区域营收占比 =
VAR 当前区域 = SELECTEDVALUE ( 'dim_customer'[region] )
VAR 分子 =
    CALCULATE (
        SUM ( 'fact_sales_order'[net_amount] ),
        'fact_sales_order'[order_status] = "已完成"
    )
VAR 分母 =
    CALCULATE (
        SUM ( 'fact_sales_order'[net_amount] ),
        'fact_sales_order'[order_status] = "已完成",
        REMOVEFILTERS ( 'dim_customer' )
    )
RETURN
    DIVIDE ( 分子, 分母 )


// -----------------------------------------------------------------------------
// 9.6 对账差异（明细 vs 订单）
// -----------------------------------------------------------------------------
// 业务含义：明细级收入合计与订单级净营收的差额。
// 使用场景：放在报表角落做"口径自检"卡片，期望恒为 0。
// 考察点：这是验证模型是否被错误地跨表放大/缩小的重要手段。
//         若明细表与订单表的关系设置成双向，或度量里漏了"仅已完成"，
//         这个数就会偏离 0。
// 期望基线：0（逐单对账差异 0 笔）
// -----------------------------------------------------------------------------
对账差异 =
[商品销售额] - [营收]


// =============================================================================
// 度量索引（速查表）
// -----------------------------------------------------------------------------
// 组 1 基础聚合   ：营收 / 吊牌额 / 折扣额 / 折扣率 / 销售成本 / 毛利 / 毛利率
//                    / 订单数 / 客户数 / 客单价 AOV / 销售数量 / 件均价            （12）
// 组 2 时间智能   ：去年同期营收 / 营收同比增长率 / 上月营收 / 营收环比增长率
//                    / 累计 YTD 营收 / 滚动 12 月营收 / 是否业务窗口               （7）
// 组 3 结构分析   ：商品销售额 / 商品销售额排名 / 商品累计销售额占比 / ABC 分类
//                    / 帕累托贡献商品数 / 帕累托贡献度 / 有销售商品数
//                    / 在售商品数 / 动销率                                     （9）
// 组 4 客户分析   ：客户最近成交日 / 客户 R 值 / 客户 F 值 / 客户 M 值 / RFM 分层
//                    / RFM 客户数 / RFM 分层客户数 / 近 90 天未成交客户数          （8）
// 组 5 库存       ：期末库存金额 / 期末库存数量 / 日均销售成本 / 库存周转天数
//                    / 缺货 SKU 数 / 缺货率 / 滞销 SKU 数 / 在途库存金额          （8）
// 组 6 销售漏斗   ：线索数 / 成单数 / 成单率 / 输单数 / 阶段到达数 / 阶段转化率
//                    / 累计转化率 / 平均销售周期天数 / 平均期望金额
//                    / 平均交付周期天数                                       （10）
// 组 7 AI 价值    ：AI 辅助商机成单率 / 对照组商机成单率 / AI 商机成单率提升
//                    / AI 辅助商机平均赢率 / 对照组商机平均赢率
//                    / AI 商机平均销售周期 / 对照组商机平均销售周期
//                    / AI 工单平均首响分钟 / 人工工单平均首响分钟
//                    / AI 工单满意度 / 人工工单满意度
//                    / AI 工单转商机率 / 人工工单转商机率
//                    / AI 采纳率 / AI 累计节省工时 / AI 首响缩短比例             （16）
// 组 8 营销运营   ：营销成本 / 营销线索数 / 归因收入 / CAC / ROAS / 行级 CAC 均值 （6）
// 组 9 辅助度量   ：各状态订单数 / 各状态营收 / 退款率 / 分层营收占比
//                    / 区域营收占比 / 对账差异                                    （6）
// -----------------------------------------------------------------------------
// 合计 52 个度量值（要求 ≥ 25）
// =============================================================================
