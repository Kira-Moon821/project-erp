      <column-instance column='[order_id]' derivation='None' name='[none:order_id:nk]' pivot='key' type='nominal' />
<column caption='营收(已完成)' datatype='real' name='[Calculation_sales_revenue]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] = &quot;已完成&quot; AND [is_return] = 0 THEN [net_amount] END)' />
      </column>
      <column-instance column='[Calculation_sales_revenue]' derivation='None' name='[none:Calculation_sales_revenue:qk]' pivot='key' type='quantitative' />
      <column caption='毛利(已完成)' datatype='real' name='[Calculation_sales_gross]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] = &quot;已完成&quot; AND [is_return] = 0 THEN [gross_profit] END)' />
      </column>
      <column-instance column='[Calculation_sales_gross]' derivation='None' name='[none:Calculation_sales_gross:qk]' pivot='key' type='quantitative' />
      <column caption='毛利率' datatype='real' name='[Calculation_sales_margin]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] = &quot;已完成&quot; AND [is_return] = 0 THEN [gross_profit] END) / SUM(IF [order_status] = &quot;已完成&quot; AND [is_return] = 0 THEN [net_amount] END)' />
      </column>
      <column-instance column='[Calculation_sales_margin]' derivation='None' name='[none:Calculation_sales_margin:qk]' pivot='key' type='quantitative' />
      <column caption='完成订单数' datatype='real' name='[Calculation_sales_orders]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [order_status] = &quot;已完成&quot; AND [is_return] = 0 THEN [order_id] END)' />
      </column>
      <column-instance column='[Calculation_sales_orders]' derivation='None' name='[none:Calculation_sales_orders:qk]' pivot='key' type='quantitative' />
      <column caption='客单价' datatype='real' name='[Calculation_sales_aov]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] = &quot;已完成&quot; AND [is_return] = 0 THEN [net_amount] END) / COUNTD(IF [order_status] = &quot;已完成&quot; AND [is_return] = 0 THEN [order_id] END)' />
      </column>
      <column-instance column='[Calculation_sales_aov]' derivation='None' name='[none:Calculation_sales_aov:qk]' pivot='key' type='quantitative' />
      <column caption='平均折扣率' datatype='real' name='[Calculation_sales_discount]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] = &quot;已完成&quot; THEN [discount_amount] END) / SUM(IF [order_status] = &quot;已完成&quot; THEN [gross_amount] END)' />
      </column>
      <column-instance column='[Calculation_sales_discount]' derivation='None' name='[none:Calculation_sales_discount:qk]' pivot='key' type='quantitative' />
      <column caption='营收同比' datatype='real' name='[Calculation_sales_yoy]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] = &quot;已完成&quot; AND [is_return] = 0 THEN [net_amount] END) / LOOKUP(SUM(IF [order_status] = &quot;已完成&quot; AND [is_return] = 0 THEN [net_amount] END), -12)' />
      </column>
      <column-instance column='[Calculation_sales_yoy]' derivation='None' name='[none:Calculation_sales_yoy:qk]' pivot='key' type='quantitative' />
      <column caption='成交客户数' datatype='real' name='[Calculation_sales_cust]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [order_status] = &quot;已完成&quot; AND [is_return] = 0 THEN [customer_id] END)' />
      </column>
      <column-instance column='[Calculation_sales_cust]' derivation='None' name='[none:Calculation_sales_cust:qk]' pivot='key' type='quantitative' />
      <layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.4' show-structure='true' />
    </datasource>
