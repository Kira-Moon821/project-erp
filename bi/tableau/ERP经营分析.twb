      <column-instance column='[lead_id]' derivation='None' name='[none:lead_id:nk]' pivot='key' type='nominal' />
<column caption='商机数' datatype='real' name='[Calculation_lead_count]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([lead_id])' />
      </column>
      <column-instance column='[Calculation_lead_count]' derivation='None' name='[none:Calculation_lead_count:qk]' pivot='key' type='quantitative' />
      <column caption='商机金额' datatype='real' name='[Calculation_lead_amount]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_amount])' />
      </column>
      <column-instance column='[Calculation_lead_amount]' derivation='None' name='[none:Calculation_lead_amount:qk]' pivot='key' type='quantitative' />
      <column caption='成单数' datatype='real' name='[Calculation_lead_win]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [stage] = &quot;成单&quot; THEN [lead_id] END)' />
      </column>
      <column-instance column='[Calculation_lead_win]' derivation='None' name='[none:Calculation_lead_win:qk]' pivot='key' type='quantitative' />
      <column caption='成单率' datatype='real' name='[Calculation_lead_rate]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [stage] = &quot;成单&quot; THEN [lead_id] END) / COUNTD([lead_id])' />
      </column>
      <column-instance column='[Calculation_lead_rate]' derivation='None' name='[none:Calculation_lead_rate:qk]' pivot='key' type='quantitative' />
      <column caption='AI辅助成单率' datatype='real' name='[Calculation_lead_ai_rate]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [stage] = &quot;成单&quot; AND [ai_assisted] = 1 THEN [lead_id] END) / COUNTD(IF [ai_assisted] = 1 THEN [lead_id] END)' />
      </column>
      <column-instance column='[Calculation_lead_ai_rate]' derivation='None' name='[none:Calculation_lead_ai_rate:qk]' pivot='key' type='quantitative' />
      <column caption='平均销售周期(天)' datatype='real' name='[Calculation_lead_cycle]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([cycle_days])' />
      </column>
      <column-instance column='[Calculation_lead_cycle]' derivation='None' name='[none:Calculation_lead_cycle:qk]' pivot='key' type='quantitative' />
      <layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.4' show-structure='true' />
    </datasource>
